{
  "name": "bulls-and-cows",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "lint": "eslint src --ext .ts",
    "format": "prettier --write src",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "tsc",
    "prepare": "husky"
  },
  "lint-staged": {
    "src/**/*.{ts,js}": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "eslint": "^10.14.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}